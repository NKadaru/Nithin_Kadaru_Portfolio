# Cloudflare Pages headers
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Security headers. The site is fully static with no inline scripts, so a
  # strict CSP costs nothing. 'unsafe-inline' is needed for style-src only
  # because the hero and marquee inject small <style> blocks for keyframes.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Vite emits content-hashed filenames, so built assets can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Never cache the entry document, so a new deploy is picked up immediately.
/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate
